# ColorMe AI Environment Configuration

# Default Provider: gemini | openai | openrouter | groq | together | ollama | custom
DEFAULT_PROVIDER=gemini

# ==========================================
# Google AI Studio / Gemini (OpenAI-compatible)
# ==========================================
# Get your API key for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_gemini_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.0-flash
# Alternative Gemini Models: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro

# ==========================================
# OpenAI Configuration
# ==========================================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ==========================================
# OpenRouter Configuration
# ==========================================
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.0-flash-001

# ==========================================
# Groq Configuration
# ==========================================
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.2-11b-vision-preview

# ==========================================
# Ollama Local Configuration (No API key needed)
# ==========================================
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2-vision
